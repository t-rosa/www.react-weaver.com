---
import Container from "../components/container.astro";
import Layout from "../layouts/Layout.astro";

const title = "React Weaver";
const description = "Full Stack SPA Template with React and ASP.NET Core";
const keywords = "template, full stack, react, asp.net core, SaaS";

const structuredData = {
  "@context": "https://schema.org",
  name: "Toma ROSA",
  url: "https://www.react-weaver.com",
  description: description,
  image: "https://www.react-weaver.com/og-image.png",
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  structuredData={structuredData}
>
  <Container>
    <header class="flex items-center justify-between p-3">
      <div class="flex items-center gap-3">
        <h1 class="font-code text-2xl font-bold">
          React<span class="text-primary">:</span>Weaver
        </h1>
      </div>
    </header>
  </Container>
</Layout>
