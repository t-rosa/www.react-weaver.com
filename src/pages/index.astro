---
import Container from "../components/container.astro";
import Layout from "../layouts/Layout.astro";

const title = "React Weaver";
const description = "Full Stack SPA Template with React and ASP.NET Core";
const keywords = "template, full stack, react, asp.net core, SaaS";

const structuredData = {
  "@context": "https://schema.org",
  name: "Toma ROSA",
  url: "https://www.react-weaver.com",
  description: description,
  image: "https://www.react-weaver.com/og-image.png",
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  structuredData={structuredData}
>
  <Container>
    <section class="grid place-items-center gap-6 py-12">
      <h1 class="text-center text-2xl leading-tight font-semibold sm:text-5xl">
        Full Stack Starter <br /><span class="font-medium">for the web</span>
      </h1>
      <h2
        class="text-muted-foreground max-w-2xs text-center text-lg sm:max-w-lg sm:text-xl"
      >
        Weaving the power of <span class="text-primary">ASP.NET Core</span> and <span
          class="text-primary">React</span
        > into one seamless experience.
      </h2>
    </section>
  </Container>
</Layout>
